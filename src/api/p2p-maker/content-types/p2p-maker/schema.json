{
  "kind": "collectionType",
  "collectionName": "p2p_makers",
  "info": {
    "singularName": "p2p-maker",
    "pluralName": "p2p-makers",
    "displayName": "p2p maker",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "string",
      "unique": true,
      "maxLength": 32
    },
    "telegram_name": {
      "type": "string",
      "maxLength": 54
    },
    "avatar": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "telegram_chat_id": {
      "type": "string",
      "unique": true
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "p_2_p_maker"
    },
    "offers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::p2p-offer.p2p-offer"
    },
    "coordinates": {
      "type": "string"
    },
    "exchanger_tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exchanger-tag.exchanger-tag"
    },
    "description": {
      "type": "text",
      "maxLength": 1000,
      "minLength": 3
    },
    "en_description": {
      "type": "text",
      "maxLength": 2000
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "paused",
        "suspended",
        "disabled",
        "blacklist",
        "draft",
        "draft2"
      ],
      "default": "active"
    },
    "telegram_post_link": {
      "type": "string"
    },
    "telegram_username": {
      "type": "string",
      "unique": true,
      "required": true
    },
    "deals_finished": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "deals_canceled": {
      "type": "integer",
      "min": 0,
      "default": 0
    },
    "rating": {
      "type": "decimal",
      "max": 5,
      "min": 2,
      "required": true,
      "default": 3
    },
    "need_ai_helper": {
      "type": "boolean",
      "default": true
    },
    "deposit_usd": {
      "type": "float",
      "min": 100
    },
    "top_parameters": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::top-parameter.top-parameter"
    },
    "coordinates_radius_km": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 100
    },
    "p2p_level": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::p2p-level.p2p-level"
    },
    "p2p_conditions_completed": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::p2p-condition.p2p-condition"
    }
  }
}
