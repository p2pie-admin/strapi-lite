{
  "kind": "collectionType",
  "collectionName": "exchangers",
  "info": {
    "singularName": "exchanger",
    "pluralName": "exchangers",
    "displayName": "exchanger",
    "description": ""
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "maxLength": 24,
      "minLength": 2,
      "unique": true,
      "required": true,
      "pluginOptions": {},
      "regex": "^[A-Za-z0-9\\- ]+$"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ],
      "pluginOptions": {}
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "active",
        "paused",
        "suspended",
        "disabled",
        "blacklist",
        "draft",
        "draft2"
      ],
      "default": "active",
      "required": true,
      "pluginOptions": {}
    },
    "tag": {
      "type": "enumeration",
      "enum": [
        "pro",
        "new"
      ],
      "pluginOptions": {}
    },
    "rates_link": {
      "type": "string",
      "regex": "(https?:\\/\\/(?:www\\.|(?!www))[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\\.[^\\s]{2,}|www\\.[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\\.[^\\s]{2,}|https?:\\/\\/(?:www\\.|(?!www))[a-zA-Z0-9]+\\.[^\\s]{2,}|www\\.[a-zA-Z0-9]+\\.[^\\s]{2,})",
      "required": false,
      "unique": true,
      "pluginOptions": {}
    },
    "ref_link": {
      "type": "string",
      "regex": "(https?:\\/\\/(?:www\\.|(?!www))[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\\.[^\\s]{2,}|www\\.[a-zA-Z0-9][a-zA-Z0-9-]+[a-zA-Z0-9]\\.[^\\s]{2,}|https?:\\/\\/(?:www\\.|(?!www))[a-zA-Z0-9]+\\.[^\\s]{2,}|www\\.[a-zA-Z0-9]+\\.[^\\s]{2,})",
      "unique": true,
      "pluginOptions": {},
      "required": false
    },
    "admin_comment": {
      "type": "text",
      "pluginOptions": {}
    },
    "admin_rating": {
      "type": "decimal",
      "default": 0,
      "min": 0,
      "max": 5,
      "pluginOptions": {}
    },
    "exchanger_card": {
      "type": "component",
      "repeatable": false,
      "component": "exchanger.exchanger"
    },
    "reviews": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::review.review",
      "mappedBy": "exchanger"
    },
    "offices": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::office.office",
      "mappedBy": "exchanger"
    },
    "exchanger_templates": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exchanger-template.exchanger-template"
    },
    "monitorings": {
      "type": "dynamiczone",
      "components": [
        "exchanger.monitoring"
      ]
    },
    "exchanger_tags": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exchanger-tag.exchanger-tag"
    },
    "display_name": {
      "type": "string"
    }
  }
}
